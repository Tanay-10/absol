# ── Required API keys ───────────────────────────────────────────
# None of the Tier 1 sources require keys, but keep this file
# as the single place to declare any future secrets.

# GDACS_API_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist
# USGS_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0
# EONET_API_URL=https://eonet.gsfc.nasa.gov/api/v3/events

# ── Backend ingestion endpoint (for export/backend_client.py) ──
# INGESTION_BASE_URL=http://localhost:8000
# INGESTION_BATCH_ENDPOINT=/ingestion/events/batch

# ── Pipeline tuning ────────────────────────────────────────────
# FETCH_TIMEOUT_SECONDS=30
# DEDUPE_TIME_WINDOW_HOURS=24
# DEDUPE_DISTANCE_KM=100

# ── SQLite database — for --db flag ────────────────────────────
# DATABASE_PATH=data/insureshield.db
